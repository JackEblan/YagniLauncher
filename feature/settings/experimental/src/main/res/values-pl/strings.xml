    <string name="enable_or_disable_sync_data">Włącz lub wyłącz synchronizację danych</string>
    <string name="lock_movement">Zablokuj przemieszczanie</string>
    <string name="prevent_other_grid_items_from_moving">Zablokuj możliwość przesuwania innych elementów siatki</string>
</resources>
